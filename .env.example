# API Sentinel Environment Configuration

# Application Environment: development, staging, production
APP_ENV=production

# Database Configuration (SQLite WAL mode by default)
DATABASE_URL=sqlite+aiosqlite:///./data/sentinel.db

# Admin Security Token (Bearer token required for API write & inspection routes)
# Generate a strong token: openssl rand -hex 32
ADMIN_TOKEN=change-me-to-a-secure-random-token-min-32-chars

# Telegram Outage & Recovery Notifications (Optional)
# Obtain token from @BotFather, and chat ID from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Monitoring Engine Configuration
DEFAULT_INTERVAL=60
DEFAULT_TIMEOUT=10
MAX_CONCURRENT_CHECKS=20

# Server Bind Settings
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
